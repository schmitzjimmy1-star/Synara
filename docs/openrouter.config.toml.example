# Copy this file to ~/.codex-openrouter/config.toml and point Synara's Codex
# home path at ~/.codex-openrouter. Codex app-server does not accept --profile.
#
# Keep the secret out of this file. Codex reads it from the process environment.
model = "openai/gpt-5.6-sol"
model_provider = "openrouter"
web_search = "disabled"

[model_providers.openrouter]
name = "OpenRouter"
base_url = "https://openrouter.ai/api/v1"
env_key = "OPENROUTER_API_KEY"
wire_api = "responses"
